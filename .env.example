# Copy this file to .env and fill in your own connection settings.
# Never commit real credentials.
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=REPLACE_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_ACCESS_KEY_SECRET
# OSS_SECURITY_TOKEN=REPLACE_STS_TOKEN
# HF_TOKEN=REPLACE_HUGGING_FACE_TOKEN
DORIS_HOST=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
# NOTEBOOK_DATASET_ROOT=oss://YOUR_BUCKET/robotics/droid100
# Set your password here; leave commented to prompt in the notebook.
# An explicitly empty DORIS_PASSWORD= means an empty password.
# DORIS_PASSWORD='REPLACE_PASSWORD'
# DORIS_SSL_CA=/absolute/path/to/ca.pem

# AWS S3: use these variables when the output URI starts with s3://.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=REPLACE_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_AWS_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=REPLACE_AWS_STS_TOKEN
# NOTEBOOK_DATASET_ROOT=s3://YOUR_BUCKET/robotics/droid100

# Optional S3-compatible service. With path-style requests, omit the bucket here.
# AWS_ENDPOINT=https://s3.example.com
# AWS_VIRTUAL_HOSTED_STYLE_REQUEST=false
# AWS_ALLOW_HTTP=false

# Doris names: initialization, vector search and label imports share these values.
DORIS_CATALOG=droid100
DORIS_DATABASE=default
DORIS_ANALYSIS_DATABASE=droid100_analysis
DORIS_TABLE_GRASP_HITS=grasp_hits
DORIS_TABLE_GRASP_REVIEW=grasp_review
DORIS_TABLE_EPISODE_POLICY=episode_policy

# Physical Lance directory names (without .lance); keep these for existing exports.
# Renaming these does not migrate data. Use a new export prefix for new names.
LANCE_TABLE_FRAMES=frames
LANCE_TABLE_EPISODES=episodes
LANCE_TABLE_MEDIA=media
LANCE_TABLE_FRAME_EMBEDDINGS=frame_embeddings
LANCE_TABLE_AUDIO_EMBEDDINGS=audio_embeddings
LANCE_TABLE_METADATA=metadata
LANCE_TABLE_EXPORT_MANIFEST=export_manifest
LANCE_TABLE_EXPORT_CHECKPOINTS=export_checkpoints
LANCE_TABLE_EXPORT_INDEX_STATUS=export_index_status
